[sections:app_manager_apps]
entries:
    .app_manager_apps

[sections:app_manager_pages]
entries:
    .app_manager_pages

[scheme:app_manager_registry_scheme]
entries:
    app_manager_apps -> flash_rodata
    app_manager_pages -> flash_rodata

[mapping:app_manager_registry_map]
archive: *
entries:
    * (app_manager_registry_scheme);
        app_manager_apps -> flash_rodata KEEP() SURROUND(app_manager_apps),
        app_manager_pages -> flash_rodata KEEP() SURROUND(app_manager_pages)
